{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/run-tests-before-commit.sh\"",
            "timeout": 180,
            "statusMessage": "Прогоняю npm test перед коммитом…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/warn-on-innerhtml.sh\"",
            "timeout": 15,
            "statusMessage": "Проверяю правку на сборку разметки строкой…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/ensure-deps.sh\"",
            "timeout": 180,
            "statusMessage": "Проверяю зависимости для тестов…"
          }
        ]
      }
    ]
  }
}
